{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "span_hash": {
          "title": "Span Hash",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "quote",
        "span_hash"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "finding": {
          "minLength": 1,
          "title": "Finding",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "finding",
        "evidence_refs"
      ],
      "title": "Observation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "context_hash": {
      "title": "Context Hash",
      "type": "string"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "minItems": 1,
      "title": "Observations",
      "type": "array"
    },
    "open_questions": {
      "items": {
        "type": "string"
      },
      "title": "Open Questions",
      "type": "array"
    }
  },
  "required": [
    "task_id",
    "context_hash",
    "observations",
    "open_questions"
  ],
  "title": "IndependentFindings",
  "type": "object"
}
